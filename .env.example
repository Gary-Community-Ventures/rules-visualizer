# API key for AI chat (get one at https://openrouter.ai)
OPEN_ROUTER_KEY=

# Optional: override the default AI model
# AI_MODEL=google/gemini-2.5-flash

# Allow write operations from the UI: editing/adding/removing policy
# references, and the Tasks (Hammer) panel which spawns the Claude CLI as
# a child process with --permission-mode bypassPermissions. Leave unset on
# anything that exposes the server to untrusted users — the panel is
# read-only and the Tasks API is unmounted in that mode.
#
# Both flags must be set together. Vite inlines VITE_ALLOW_WRITES at
# build time, so it must be present in the build environment too.
# VITE_ALLOW_WRITES=1
# ALLOW_WRITES=1

# Optional: use OpenCode for Tasks panel edits instead of Claude Code
# TASK_AGENT_RUNNER=opencode
# OPENCODE_MODEL=openai/gpt-5.5
# OPENCODE_VARIANT=medium
