# API key for AI chat (get one at https://openrouter.ai)
OPEN_ROUTER_KEY=

# Optional: override the default AI model
# AI_MODEL=google/gemini-2.5-flash

# Show the Tasks (Hammer) panel in the toolbar. Vite inlines this at build
# time, so leave it unset on the prod machine to keep the button hidden.
# VITE_TASKS_ENABLED=1

# Mount the Tasks API on the backend. The Tasks routes spawn the Claude CLI
# as a child process with --permission-mode bypassPermissions, so do NOT
# enable this in any environment that exposes the server to untrusted users.
# Required independently of VITE_TASKS_ENABLED.
# TASKS_ENABLED=1
