# API key for AI chat (get one at https://openrouter.ai)
OPEN_ROUTER_KEY=

# Optional: override the default AI model
# AI_MODEL=google/gemini-2.5-flash

# Show the Tasks (Hammer) panel in the toolbar. Vite inlines this at build
# time, so leave it unset on the prod machine to keep the button hidden.
# VITE_TASKS_ENABLED=1
