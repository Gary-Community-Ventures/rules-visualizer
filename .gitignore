# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-error.log*

# Dependency directories
node_modules/
bower_components/
jspm_packages/

# Vendored upstream — built per-machine, never committed by default.
vendor/

# Exceptions: un-ignore the factgraph-core vendor directory so we can
# commit the factgraph-rs WASM module (rebuilding it requires the
# sibling factgraph-rs repo + rustup + wasm-pack; checkouts and the
# Heroku deploy path shouldn't have to). The Scala.js bundle next to
# it is still ignored (large, built upstream).
!packages/factgraph-core/vendor/
packages/factgraph-core/vendor/factgraph-scala.cjs

# Vite-specific
.vite/
dist/

# Testing
/coverage/
.nyc_output/

# Production
/build

# Built frontend bundled into backends
packages/*/public/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.venv/
venv/

# Misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Bruno stores secret-var values (e.g. api_token) in per-environment
# .env.local files alongside the .bru env config. Keep them out of git.
*.env.local

# IDEs and editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# yarn package manager
yarn.lock

# pnpm package manager
pnpm-lock.yaml

# editorconfig
.editorconfig

# Prettier
.prettierignore

# ESLint
.eslintcache

# TypeScript
*.tsbuildinfo
.stashed/

# Claude Code tasks panel — per-thread persistence
.claude-tasks/

# Generated simulation run output
data/factgraph/*/simulations/

# Per-machine engine-bench results (markdown + csv). The headline numbers
# from the canonical run live in scripts/bench-engines/README.md; commit
# fresh result files only when intentionally updating that baseline.
scripts/bench-engines/results/
