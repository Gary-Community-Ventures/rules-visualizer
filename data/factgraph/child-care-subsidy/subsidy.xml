<FactDictionaryModule>
  <Facts>
    <!-- ============================================================ -->
    <!-- INPUTS — facts the applicant provides                        -->
    <!-- ============================================================ -->

    <Fact path="/annualIncome">
      <Name>Annual household income</Name>
      <Description>Total annual gross income for the household</Description>
      <Writable><Dollar /></Writable>
    </Fact>

    <Fact path="/householdSize">
      <Name>Household size</Name>
      <Description>Total number of people in the household</Description>
      <Writable><Int /></Writable>
    </Fact>

    <Fact path="/numberOfChildrenInCare">
      <Name>Children in care</Name>
      <Description>Number of children needing child care</Description>
      <Writable><Int /></Writable>
    </Fact>

    <Fact path="/monthlyChildCareCost">
      <Name>Monthly child care cost</Name>
      <Description>Total monthly child care expenses for all children</Description>
      <Writable><Dollar /></Writable>
    </Fact>

    <Fact path="/isEmployedOrInTraining">
      <Name>Employed or in training</Name>
      <Description>Whether the applicant is employed, in school, or in a job training program</Description>
      <Writable><Boolean /></Writable>
    </Fact>

    <!-- ============================================================ -->
    <!-- CONSTANTS — values set by program rules                      -->
    <!-- ============================================================ -->

    <Fact path="/baseIncomeLimit">
      <Name>Base income limit</Name>
      <Description>Base income limit for a household of one</Description>
      <Derived><Dollar>25000</Dollar></Derived>
    </Fact>

    <Fact path="/incomeLimitPerAdditionalPerson">
      <Name>Income limit per additional person</Name>
      <Description>Additional income allowance per household member beyond the first</Description>
      <Derived><Dollar>7500</Dollar></Derived>
    </Fact>

    <Fact path="/maxSubsidyPerChild">
      <Name>Max subsidy per child</Name>
      <Description>Maximum monthly subsidy per child</Description>
      <Derived><Dollar>600</Dollar></Derived>
    </Fact>

    <Fact path="/copayPercent">
      <Name>Copay percent</Name>
      <Description>Percentage of monthly income used to calculate family copay (7 = 7%)</Description>
      <Derived><Int>7</Int></Derived>
    </Fact>

    <Fact path="/minCopay">
      <Name>Minimum copay</Name>
      <Description>Minimum monthly copay regardless of income</Description>
      <Derived><Dollar>25</Dollar></Derived>
    </Fact>

    <!-- ============================================================ -->
    <!-- COMPUTED — calculated from inputs and constants               -->
    <!-- ============================================================ -->

    <Fact path="/incomeLimit">
      <Name>Income limit</Name>
      <Description>Maximum income for eligibility based on household size</Description>
      <Derived>
        <Add>
          <Dependency path="/baseIncomeLimit" />
          <Multiply>
            <GreaterOf>
              <Subtract>
                <Minuend><Dependency path="/householdSize" /></Minuend>
                <Subtrahends><Int>1</Int></Subtrahends>
              </Subtract>
              <Int>0</Int>
            </GreaterOf>
            <Dependency path="/incomeLimitPerAdditionalPerson" />
          </Multiply>
        </Add>
      </Derived>
    </Fact>

    <Fact path="/incomeEligible">
      <Name>Income eligible</Name>
      <Description>Whether household income is within the limit</Description>
      <Derived>
        <LessThanOrEqual>
          <Left><Dependency path="/annualIncome" /></Left>
          <Right><Dependency path="/incomeLimit" /></Right>
        </LessThanOrEqual>
      </Derived>
    </Fact>

    <Fact path="/hasChildrenInCare">
      <Name>Has children in care</Name>
      <Description>Whether there is at least one child needing care</Description>
      <Derived>
        <GreaterThanOrEqual>
          <Left><Dependency path="/numberOfChildrenInCare" /></Left>
          <Right><Int>1</Int></Right>
        </GreaterThanOrEqual>
      </Derived>
    </Fact>

    <Fact path="/eligible">
      <Name>Eligible for subsidy</Name>
      <Description>Whether the applicant meets all eligibility requirements</Description>
      <Derived>
        <All>
          <Dependency path="/incomeEligible" />
          <Dependency path="/isEmployedOrInTraining" />
          <Dependency path="/hasChildrenInCare" />
        </All>
      </Derived>
    </Fact>

    <Fact path="/monthlyCopay">
      <Name>Monthly copay</Name>
      <Description>The family's monthly copayment based on income (7% of monthly income, min $25)</Description>
      <Derived>
        <GreaterOf>
          <Dependency path="/minCopay" />
          <Divide>
            <Dividend>
              <Multiply>
                <Dependency path="/annualIncome" />
                <Dependency path="/copayPercent" />
              </Multiply>
            </Dividend>
            <Divisors><Int>1200</Int></Divisors>
          </Divide>
        </GreaterOf>
      </Derived>
    </Fact>

    <Fact path="/totalMonthlySubsidy">
      <Name>Total monthly subsidy</Name>
      <Description>Total monthly subsidy for all children, zero if not eligible</Description>
      <Derived>
        <Switch>
          <Case>
            <When><Dependency path="/eligible" /></When>
            <Then>
              <LesserOf>
                <Multiply>
                  <Dependency path="/maxSubsidyPerChild" />
                  <Dependency path="/numberOfChildrenInCare" />
                </Multiply>
                <GreaterOf>
                  <Subtract>
                    <Minuend><Dependency path="/monthlyChildCareCost" /></Minuend>
                    <Subtrahends><Dependency path="/monthlyCopay" /></Subtrahends>
                  </Subtract>
                  <Dollar>0</Dollar>
                </GreaterOf>
              </LesserOf>
            </Then>
          </Case>
          <Case>
            <When><True /></When>
            <Then><Dollar>0</Dollar></Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

  </Facts>
</FactDictionaryModule>
