[
  {
    "id": "test-1",
    "name": "Single child, employed",
    "inputs": {
      "/isEmployed": true
    },
    "entities": {
      "/members": [
        {
          "/members/*/age": 5,
          "/members/*/isDisabled": false,
          "/members/*/monthlyIncome": 0
        }
      ]
    },
    "expect": {
      "/members/*/isChild": [true],
      "/members/*/memberBenefit": [150],
      "/totalMonthlyBenefit": 150
    }
  },
  {
    "id": "test-2",
    "name": "Mixed household, employed",
    "inputs": {
      "/isEmployed": true
    },
    "entities": {
      "/members": [
        {
          "/members/*/age": 5,
          "/members/*/isDisabled": false,
          "/members/*/monthlyIncome": 0
        },
        {
          "/members/*/age": 70,
          "/members/*/isDisabled": true,
          "/members/*/monthlyIncome": 1500
        },
        {
          "/members/*/age": 35,
          "/members/*/isDisabled": false,
          "/members/*/monthlyIncome": 3000
        }
      ]
    },
    "expect": {
      "/members/*/isChild": [true, false, false],
      "/members/*/memberBenefit": [150, 275, 0],
      "/totalMonthlyBenefit": 425
    }
  }
]
