# SNAP (Supplemental Nutrition Assistance Program) — Eligibility & Benefit
#
# A simplified encoding of federal SNAP rules based on 7 USC 2014-2017.
# Determines household eligibility via gross and net income tests,
# then calculates the monthly benefit as max allotment minus 30% of net income.

status: encoded

# --- Inputs (facts about the household) ---

gross_earned_income:
    dtype: Money
    unit: USD
    label: "Gross earned income"
    description: "Monthly earned income before taxes (wages, salary, self-employment)"
    default: 0

unearned_income:
    dtype: Money
    unit: USD
    label: "Unearned income"
    description: "Monthly unearned income (Social Security, unemployment, child support, etc.)"
    default: 0

household_size:
    dtype: Integer
    label: "Household size"
    description: "Number of people in the SNAP household"
    default: 1

dependent_care_expenses:
    dtype: Money
    unit: USD
    label: "Dependent care expenses"
    description: "Monthly out-of-pocket dependent care costs"
    default: 0

shelter_costs:
    dtype: Money
    unit: USD
    label: "Shelter costs"
    description: "Monthly shelter costs (rent/mortgage, property tax, insurance, utilities)"
    default: 0

medical_expenses_elderly_disabled:
    dtype: Money
    unit: USD
    label: "Medical expenses (elderly/disabled)"
    description: "Monthly out-of-pocket medical expenses for elderly/disabled members over $35"
    default: 0

has_elderly_or_disabled_member:
    dtype: Boolean
    label: "Elderly or disabled member"
    description: "Whether household has a member who is age 60+ or disabled"
    default: false

# --- Constants (federal SNAP parameters, FY2024) ---

earned_income_deduction_rate:
    description: "20% earned income deduction per 7 USC 2014(e)(1)"
    from 2024-10-01: 0.20

standard_deduction_1_to_3:
    description: "Standard deduction for households of 1-3 people"
    unit: USD
    from 2024-10-01: 209

standard_deduction_4:
    description: "Standard deduction for household of 4"
    unit: USD
    from 2024-10-01: 225

standard_deduction_5:
    description: "Standard deduction for household of 5"
    unit: USD
    from 2024-10-01: 263

standard_deduction_6_plus:
    description: "Standard deduction for household of 6+"
    unit: USD
    from 2024-10-01: 300

excess_shelter_deduction_cap:
    description: "Cap on excess shelter deduction for non-elderly/disabled households"
    unit: USD
    from 2024-10-01: 672

medical_deduction_threshold:
    description: "Only medical expenses above this threshold are deductible"
    unit: USD
    from 2024-10-01: 35

gross_income_limit_pct:
    description: "Gross income must be at or below 130% of federal poverty level"
    from 2024-10-01: 1.30

net_income_limit_pct:
    description: "Net income must be at or below 100% of federal poverty level"
    from 2024-10-01: 1.00

benefit_reduction_rate:
    description: "Households expected to spend 30% of net income on food"
    from 2024-10-01: 0.30

minimum_benefit:
    description: "Minimum monthly benefit for 1-2 person households"
    unit: USD
    from 2024-10-01: 23

# Federal poverty level monthly amounts by household size (FY2024, 48 states + DC)
fpl_monthly_1:
    unit: USD
    from 2024-10-01: 1255

fpl_monthly_2:
    unit: USD
    from 2024-10-01: 1705

fpl_monthly_3:
    unit: USD
    from 2024-10-01: 2155

fpl_monthly_4:
    unit: USD
    from 2024-10-01: 2605

fpl_monthly_per_additional:
    description: "Additional FPL amount per person beyond 4"
    unit: USD
    from 2024-10-01: 450

# Max allotment by household size (FY2024, 48 states + DC)
max_allotment_1:
    unit: USD
    from 2024-10-01: 292

max_allotment_2:
    unit: USD
    from 2024-10-01: 536

max_allotment_3:
    unit: USD
    from 2024-10-01: 768

max_allotment_4:
    unit: USD
    from 2024-10-01: 975

max_allotment_per_additional:
    description: "Additional max allotment per person beyond 4"
    unit: USD
    from 2024-10-01: 195

# --- Computed ---

gross_monthly_income:
    dtype: Money
    unit: USD
    label: "Gross monthly income"
    description: "Total monthly income before deductions"
    from 2024-10-01:
        gross_earned_income + unearned_income

# FPL lookup based on household size
federal_poverty_level_monthly:
    dtype: Money
    unit: USD
    label: "Federal poverty level (monthly)"
    description: "Monthly FPL for this household size"
    from 2024-10-01:
        if household_size <= 1: fpl_monthly_1
        elif household_size == 2: fpl_monthly_2
        elif household_size == 3: fpl_monthly_3
        elif household_size == 4: fpl_monthly_4
        else: fpl_monthly_4 + (fpl_monthly_per_additional * (household_size - 4))

# Gross income test: 130% FPL
gross_income_limit:
    dtype: Money
    unit: USD
    label: "Gross income limit"
    description: "130% of FPL — maximum gross monthly income for eligibility"
    from 2024-10-01:
        federal_poverty_level_monthly * gross_income_limit_pct

gross_income_eligible:
    dtype: Boolean
    label: "Passes gross income test"
    description: "Whether gross monthly income is at or below 130% of FPL"
    from 2024-10-01:
        gross_monthly_income <= gross_income_limit

# Deductions
earned_income_deduction:
    dtype: Money
    unit: USD
    label: "Earned income deduction"
    description: "20% of gross earned income"
    from 2024-10-01:
        gross_earned_income * earned_income_deduction_rate

standard_deduction:
    dtype: Money
    unit: USD
    label: "Standard deduction"
    description: "Standard deduction based on household size"
    from 2024-10-01:
        if household_size <= 3: standard_deduction_1_to_3
        elif household_size == 4: standard_deduction_4
        elif household_size == 5: standard_deduction_5
        else: standard_deduction_6_plus

medical_deduction:
    dtype: Money
    unit: USD
    label: "Medical deduction"
    description: "Medical expenses over $35/month for elderly/disabled members"
    from 2024-10-01:
        if has_elderly_or_disabled_member:
            max(0, medical_expenses_elderly_disabled - medical_deduction_threshold)
        else:
            0

income_after_preliminary_deductions:
    dtype: Money
    unit: USD
    label: "Income after preliminary deductions"
    description: "Gross income minus earned income, standard, dependent care, and medical deductions"
    from 2024-10-01:
        max(0, gross_monthly_income - earned_income_deduction - standard_deduction - dependent_care_expenses - medical_deduction)

# Excess shelter deduction
half_income_after_deductions:
    dtype: Money
    unit: USD
    label: "Half of adjusted income"
    description: "50% of income after preliminary deductions"
    from 2024-10-01:
        income_after_preliminary_deductions / 2

excess_shelter_cost:
    dtype: Money
    unit: USD
    label: "Excess shelter cost"
    description: "Shelter costs exceeding 50% of income after other deductions"
    from 2024-10-01:
        max(0, shelter_costs - half_income_after_deductions)

shelter_deduction:
    dtype: Money
    unit: USD
    label: "Shelter deduction"
    description: "Excess shelter deduction, capped unless elderly/disabled member present"
    from 2024-10-01:
        if has_elderly_or_disabled_member:
            excess_shelter_cost
        else:
            min(excess_shelter_cost, excess_shelter_deduction_cap)

# Net income
net_monthly_income:
    dtype: Money
    unit: USD
    label: "Net monthly income"
    description: "Income after all deductions"
    from 2024-10-01:
        max(0, income_after_preliminary_deductions - shelter_deduction)

# Net income test: 100% FPL
net_income_limit:
    dtype: Money
    unit: USD
    label: "Net income limit"
    description: "100% of FPL — maximum net monthly income for eligibility"
    from 2024-10-01:
        federal_poverty_level_monthly * net_income_limit_pct

net_income_eligible:
    dtype: Boolean
    label: "Passes net income test"
    description: "Whether net monthly income is at or below 100% of FPL"
    from 2024-10-01:
        net_monthly_income <= net_income_limit

# Overall eligibility
eligible:
    dtype: Boolean
    label: "Eligible for SNAP"
    description: "Whether household passes both gross and net income tests (elderly/disabled exempt from gross test)"
    from 2024-10-01:
        if has_elderly_or_disabled_member:
            net_income_eligible
        else:
            gross_income_eligible and net_income_eligible

# Benefit calculation
max_allotment:
    dtype: Money
    unit: USD
    label: "Maximum allotment"
    description: "Maximum monthly SNAP benefit for this household size"
    from 2024-10-01:
        if household_size <= 1: max_allotment_1
        elif household_size == 2: max_allotment_2
        elif household_size == 3: max_allotment_3
        elif household_size == 4: max_allotment_4
        else: max_allotment_4 + (max_allotment_per_additional * (household_size - 4))

expected_food_contribution:
    dtype: Money
    unit: USD
    label: "Expected food contribution"
    description: "30% of net income — the amount the household is expected to spend on food"
    from 2024-10-01:
        net_monthly_income * benefit_reduction_rate

calculated_benefit:
    dtype: Money
    unit: USD
    label: "Calculated benefit"
    description: "Max allotment minus 30% of net income"
    from 2024-10-01:
        max(0, max_allotment - expected_food_contribution)

monthly_snap_benefit:
    dtype: Money
    unit: USD
    label: "Monthly SNAP benefit"
    description: "Final monthly benefit amount, zero if not eligible, with minimum benefit floor for small households"
    from 2024-10-01:
        if eligible:
            if household_size <= 2:
                max(minimum_benefit, calculated_benefit)
            else:
                calculated_benefit
        else:
            0
