# Household Benefits Program
#
# A simplified benefits program that determines household eligibility
# and calculates per-member benefit amounts. Demonstrates entity-level
# (per-person) variables alongside household-level (scalar) variables.
#
# HouseholdMember entity variables are computed once per member.
# Scalar variables are computed once for the whole household.

status: encoded

# --- Inputs (household-level) ---

is_employed:
    dtype: Boolean
    label: "Household has employed member"
    description: "Whether any household member is currently employed"
    default: false

# --- Inputs (per-member) ---

age:
    entity: HouseholdMember
    dtype: Integer
    label: "Age"
    description: "Age of the household member"
    default: 0

is_disabled:
    entity: HouseholdMember
    dtype: Boolean
    label: "Is disabled"
    description: "Whether the member has a qualifying disability"
    default: false

monthly_income:
    entity: HouseholdMember
    dtype: Money
    unit: USD
    label: "Monthly income"
    description: "Member's monthly income from all sources"
    default: 0

# --- Constants ---

child_age_limit:
    description: "Age below which a member qualifies as a child"
    from 2024-01-01: 18

senior_age_threshold:
    description: "Age at or above which a member qualifies as senior"
    from 2024-01-01: 65

base_benefit_per_child:
    description: "Monthly benefit per qualifying child"
    unit: USD
    from 2024-01-01: 150

base_benefit_per_senior:
    description: "Monthly benefit per qualifying senior"
    unit: USD
    from 2024-01-01: 200

disability_supplement:
    description: "Additional monthly benefit for disabled members"
    unit: USD
    from 2024-01-01: 75

income_limit_per_member:
    description: "Maximum monthly income per member for eligibility"
    unit: USD
    from 2024-01-01: 2000

# --- Computed (per-member) ---

is_child:
    entity: HouseholdMember
    dtype: Boolean
    label: "Is a child"
    description: "Whether the member is under the child age limit"
    from 2024-01-01:
        age < child_age_limit

is_senior:
    entity: HouseholdMember
    dtype: Boolean
    label: "Is a senior"
    description: "Whether the member is at or above the senior age threshold"
    from 2024-01-01:
        age >= senior_age_threshold

income_eligible:
    entity: HouseholdMember
    dtype: Boolean
    label: "Income eligible"
    description: "Whether the member's income is below the limit"
    from 2024-01-01:
        monthly_income <= income_limit_per_member

member_benefit:
    entity: HouseholdMember
    dtype: Money
    unit: USD
    label: "Member benefit"
    description: "Monthly benefit amount for this member"
    from 2024-01-01:
        base = if is_child: base_benefit_per_child elif is_senior: base_benefit_per_senior else: 0
        supplement = if is_disabled: disability_supplement else: 0
        if income_eligible: (base + supplement) else: 0

# --- Computed (household-level, aggregates over members) ---

total_monthly_benefit:
    dtype: Money
    unit: USD
    label: "Total monthly benefit"
    description: "Sum of all member benefits, requires employment"
    from 2024-01-01:
        if is_employed: sum(member_benefit) else: 0
