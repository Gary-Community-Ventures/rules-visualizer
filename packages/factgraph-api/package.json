{
  "name": "rules-visualizer-factgraph-api",
  "version": "0.1.0",
  "description": "Partner-facing HTTP adapter API for Fact Graph rulesets — generic query, missing-input discovery, and (later) structured explanations. Built on top of rules-visualizer-factgraph-core.",
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "rules-visualizer-factgraph-api": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "gen:openapi": "tsx scripts/generate-openapi.ts",
    "gen:dictionary": "tsx scripts/generate-input-dictionary.ts",
    "gen:engine-inputs": "tsx scripts/generate-engine-inputs.ts",
    "gen:examples": "tsx scripts/generate-query-examples.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.3",
    "rules-visualizer-factgraph-core": "*",
    "rules-visualizer-shared-types": "*",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/node": "^24.0.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
