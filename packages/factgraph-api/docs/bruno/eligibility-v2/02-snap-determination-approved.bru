meta {
  name: 02 SNAP determination — approved household
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v2/eligibility/snap/determination
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{api_token}}
}

